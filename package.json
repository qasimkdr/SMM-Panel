{
  "name": "smm-panel",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @smm/db generate",
    "db:migrate": "pnpm --filter @smm/db migrate",
    "db:seed": "pnpm --filter @smm/db seed"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0"
  }
}
