{
  "name": "@smm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean --noExternal @smm/shared --noExternal @smm/db",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@smm/db": "workspace:*",
    "@smm/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.0"
  }
}
