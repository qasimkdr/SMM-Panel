# Image for the API and the worker (same code base, different start command).
# Works on x86 and ARM (Oracle Ampere). Build:  docker build -f deploy/Dockerfile.node --build-arg APP=api .
FROM node:22-alpine AS build
ARG APP=api
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile \
 && pnpm --filter @smm/${APP} build

FROM node:22-alpine
ARG APP=api
ENV NODE_ENV=production APP=${APP}
WORKDIR /repo
RUN corepack enable && apk add --no-cache tini
# Whole workspace is copied so `pnpm --filter @smm/db migrate|seed` can also run from this image.
COPY --from=build /repo /repo
USER node
WORKDIR /repo/apps/${APP}
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/index.js"]
