# ─────────────────────────────────────────────────────────────────────────────
# Production settings. Copy to the repo root as `.env` on the server:
#   cp deploy/env.production.example .env && nano .env
# Generate each secret with:  openssl rand -base64 48
# Never commit the filled-in file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
APP_NAME=Panel

# Your address. No "https://" in the two *_DOMAIN values.
# No domain yet? Use your free DuckDNS name: yourpanel.duckdns.org and admin.yourpanel.duckdns.org
PUBLIC_DOMAIN=yourpanel.duckdns.org
ADMIN_DOMAIN=admin.yourpanel.duckdns.org
WEB_URL=https://yourpanel.duckdns.org

# Internal addresses inside Docker (leave as they are)
API_URL=http://api:4000
WEB_INTERNAL_URL=http://web:3000
NEXT_PUBLIC_API_URL=/api
DATABASE_URL=mysql://smm:CHANGE_ME_DB_PASSWORD@mysql:3306/smm
REDIS_URL=redis://redis:6379

# Database passwords (must match the password inside DATABASE_URL above)
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# 2G fits the 24 GB Oracle free VM comfortably; use 512M on a 2–4 GB server.
MYSQL_BUFFER_POOL=2G

# Security secrets (each: openssl rand -base64 48). Changing ENCRYPTION_KEY later breaks saved provider keys.
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME

# How visitors reach the server — choose ONE:
#   caddy  = no domain yet (free DuckDNS name, e.g. yourpanel.duckdns.org); opens ports 80/443, free HTTPS
#   tunnel = your own domain on Cloudflare (recommended later); needs CLOUDFLARE_TUNNEL_TOKEN
COMPOSE_PROFILES=caddy
# Cloudflare Tunnel token (only for COMPOSE_PROFILES=tunnel): Zero Trust → Networks → Tunnels → token after "--token"
CLOUDFLARE_TUNNEL_TOKEN=

# Email via Resend (free: 3,000/month, 100/day). Sender must be on your verified domain.
RESEND_API_KEY=
# Resend needs a domain you own to send from; without one, leave RESEND_API_KEY empty (emails are skipped).
MAIL_FROM="Panel <no-reply@yourdomain.com>"

# Optional: Sign in with Google (also switch it on in Admin → Settings → Sign-up & security)
# Redirect URI to register in Google Cloud: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin account, created on the first start. Change the password right after signing in.
SEED_ADMIN_EMAIL=you@yourdomain.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Scale
API_REPLICAS=2
ORDER_CONCURRENCY=20
STATUS_POLL_MS=60000
LOG_LEVEL=info
