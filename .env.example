# ---- Core ----
NODE_ENV=development
APP_NAME=Panel
PUBLIC_DOMAIN=localhost:3000          # customer site, e.g. mypanel.com
ADMIN_DOMAIN=admin.localhost:3000     # admin site, e.g. admin.mypanel.com
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000         # server-side URL the web app uses to reach the API
NEXT_PUBLIC_API_URL=/api              # browser URL (proxied by Next / nginx)

# ---- Database / cache ----
DATABASE_URL=mysql://smm:smm@127.0.0.1:3306/smm
REDIS_URL=redis://127.0.0.1:6379
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- Security (generate with: openssl rand -base64 48) ----
JWT_SECRET=replace-with-64-random-chars
ENCRYPTION_KEY=replace-with-32-byte-base64-key   # AES-256-GCM key for provider API keys

# ---- On-demand page refresh (API -> web) ----
REVALIDATE_SECRET=replace-with-random-string
WEB_INTERNAL_URL=http://localhost:3000

# ---- Email (Resend free tier) ----
RESEND_API_KEY=
MAIL_FROM="Panel <no-reply@mypanel.com>"

# ---- Google sign-in (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- First admin (used by db:seed) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
